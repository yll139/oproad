#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x555555832dc0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x555555832f50 .scope module, "tb_test" "tb_test" 3 3;
 .timescale -9 -12;
v0x555555881f40_0 .var "a", 7 0;
v0x555555882020_0 .var "b", 7 0;
v0x5555558820f0_0 .var "clk", 0 0;
v0x5555558821f0_0 .var "rst_n", 0 0;
v0x5555558822c0_0 .net "y", 8 0, v0x555555881d70_0;  1 drivers
S_0x55555586d310 .scope module, "dut" "test" 3 11, 4 1 0, S_0x555555832f50;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst_n";
    .port_info 2 /INPUT 8 "a";
    .port_info 3 /INPUT 8 "b";
    .port_info 4 /OUTPUT 9 "y";
v0x555555834ba0_0 .net "a", 7 0, v0x555555881f40_0;  1 drivers
v0x555555881b00_0 .net "b", 7 0, v0x555555882020_0;  1 drivers
v0x555555881be0_0 .net "clk", 0 0, v0x5555558820f0_0;  1 drivers
v0x555555881cb0_0 .net "rst_n", 0 0, v0x5555558821f0_0;  1 drivers
v0x555555881d70_0 .var "y", 8 0;
E_0x55555586d9c0/0 .event negedge, v0x555555881cb0_0;
E_0x55555586d9c0/1 .event posedge, v0x555555881be0_0;
E_0x55555586d9c0 .event/or E_0x55555586d9c0/0, E_0x55555586d9c0/1;
    .scope S_0x55555586d310;
T_0 ;
    %wait E_0x55555586d9c0;
    %load/vec4 v0x555555881cb0_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 9;
    %assign/vec4 v0x555555881d70_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x555555834ba0_0;
    %pad/u 9;
    %load/vec4 v0x555555881b00_0;
    %pad/u 9;
    %add;
    %assign/vec4 v0x555555881d70_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x555555832f50;
T_1 ;
    %delay 5000, 0;
    %load/vec4 v0x5555558820f0_0;
    %inv;
    %store/vec4 v0x5555558820f0_0, 0, 1;
    %jmp T_1;
    .thread T_1;
    .scope S_0x555555832f50;
T_2 ;
    %vpi_call/w 3 22 "$dumpfile", "src/tb/test.vcd" {0 0 0};
    %vpi_call/w 3 23 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x555555832f50 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5555558820f0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5555558821f0_0, 0, 1;
    %pushi/vec4 0, 0, 8;
    %store/vec4 v0x555555881f40_0, 0, 8;
    %pushi/vec4 0, 0, 8;
    %store/vec4 v0x555555882020_0, 0, 8;
    %delay 20000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5555558821f0_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 10, 0, 8;
    %store/vec4 v0x555555881f40_0, 0, 8;
    %pushi/vec4 20, 0, 8;
    %store/vec4 v0x555555882020_0, 0, 8;
    %delay 10000, 0;
    %pushi/vec4 5, 0, 8;
    %store/vec4 v0x555555881f40_0, 0, 8;
    %pushi/vec4 7, 0, 8;
    %store/vec4 v0x555555882020_0, 0, 8;
    %delay 10000, 0;
    %pushi/vec4 100, 0, 8;
    %store/vec4 v0x555555881f40_0, 0, 8;
    %pushi/vec4 50, 0, 8;
    %store/vec4 v0x555555882020_0, 0, 8;
    %delay 10000, 0;
    %pushi/vec4 255, 0, 8;
    %store/vec4 v0x555555881f40_0, 0, 8;
    %pushi/vec4 1, 0, 8;
    %store/vec4 v0x555555882020_0, 0, 8;
    %delay 50000, 0;
    %vpi_call/w 3 35 "$finish" {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "src/tb/tb_test.v";
    "src/rtl/test.v";
